# Google Drive folder ID containing your videos
DRIVE_FOLDER_ID=
VIDEO_GENERATOR_API_URL=http://127.0.0.1:8001

# Groq API key and model
GROQ_API_KEY=
GROQ_MODEL=qwen/qwen3.6-27b
GROQ_VISION_MODEL=qwen/qwen3.8-27b
GROQ_TRANSCRIPTION_MODEL=whisper-large-v3-turbo

# Optional OpenAI-compatible fallback for metadata/transcription during Groq outages
METADATA_FALLBACK_API_KEY=
METADATA_FALLBACK_BASE_URL=https://api.openai.com/v1
METADATA_FALLBACK_MODEL=gpt-4o-mini
METADATA_FALLBACK_TRANSCRIPTION_MODEL=whisper-1
FACEBOOK_PAGE_URL=

# Geoapify API key for lead address geocoding
GEOAPIFY_API_KEY=

# Describe your content type
CONTENT_DESCRIPTION=short-form video content

# Timezone and daily YouTube publishing slots
TIMEZONE=Asia/Karachi
SLOT_A_TIME=17:30
SLOT_B_TIME=21:30

# YouTube category (22 = People & Blogs)
YOUTUBE_CATEGORY_ID=22

# How many days to keep completed entries in the publish queue
QUEUE_PRUNE_DAYS=30

# Telegram bot and destination channel
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Comma-separated Telegram numeric user IDs allowed to control publishing
TELEGRAM_ALLOWED_USER_IDS=
